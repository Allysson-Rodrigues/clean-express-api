{
  "name": "clean-express-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Node.js API built with TypeScript and Clean Architecture principles.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
